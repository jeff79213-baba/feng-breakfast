rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function acct() {
      return get(/databases/$(database)/documents/fz_accounts/$(request.auth.uid));
    }
    function active() {
      return request.auth != null
          && exists(/databases/$(database)/documents/fz_accounts/$(request.auth.uid))
          && acct().data.disabled == false;
    }
    function isOwner() {
      return active() && acct().data.role == 'owner';
    }

    match /fz_accounts/{uid} {
      allow read:  if active() && (request.auth.uid == uid || isOwner());
      allow write: if false;
    }
    match /fz_login_attempts/{a} {
      allow read, write: if false;
    }

    match /fz_days/{date} {
      allow read, write: if active();
    }

    match /fz_pantry/{doc} {
      allow read, write: if active();
    }

    match /fz_config/app {
      allow read:   if active();
      allow create: if isOwner();
      allow update: if isOwner()
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['dishLib', 'updatedAt', 'updatedBy']);
      allow delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
